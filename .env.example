# Better Auth configuration (required)
# Public URL of the deployed application
BETTER_AUTH_URL=https://your-app.vercel.app
# Signing secret for sessions/tokens. Generate with: `bun x @better-auth/cli secret`
BETTER_AUTH_SECRET=replace-with-a-generated-secret

# One-time seed account created by the /setup page.
# Left unset for local development, the seed falls back to
# admin@example.com / admin12345 (see AGENTS.md). Uncomment and set a strong
# password before running /setup anywhere that is not a throwaway instance.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-strong-password
